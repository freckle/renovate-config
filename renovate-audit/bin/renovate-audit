#!/usr/bin/env ruby
$LOAD_PATH << File.expand_path("../lib", __dir__)

require "base64"
require "rainbow"
require "octokit"
require "optparse"
require "renovate_audit/github/contents"
require "renovate_audit/github/pull_request"
require "renovate_audit/github/repository"
require "renovate_audit/options"
require "renovate_audit/report"

module RenovateAudit
  class Main
    def self.run
      options = Options.new

      client = Octokit::Client.new(access_token: options.token)
      client.auto_paginate = true

      report = Report.new
      repositories = GitHub::Repository.for_organization(client, options.organization).reject do |repo|
        options.excludes.include?(repo.name) || repo.archived || repo.forked
      end

      puts "Fetching data on #{repositories.size} repositories..."

      repositories.each do |repository|
        pull_requests = GitHub::PullRequest.list_open(client, repository)

        contents = Report::AUDIT_PATHS.each.with_object({}) do |path, h|
          h[path] = GitHub::Contents.get(client, repository, path)
        end

        report.audit_repository(repository, pull_requests, contents)
      end

      if report.issues.any?
        report.render_issues
        exit 1 if options.exit_code
      else
        puts "All repositories have passed the audit"
      end
    end
  end
end

if ENV["GITHUB_ACTIONS"] == "true"
  Rainbow.enabled = true # spoof tty detection
end

RenovateAudit::Main.run
