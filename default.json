{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "config:recommended",
      ":label(renovate)",
      ":automergeMajor",
      ":automergePatch",
      ":automergeMinor",
      ":automergeDigest",
      ":disableDependencyDashboard",
      ":prConcurrentLimit10",
      ":prHourlyLimitNone",
      ":renovatePrefix",
      ":semanticCommits",
      ":timezone(America/New_York)",
      "schedule:daily"
    ],
    "minimumReleaseAge": "5 days",
    "platformAutomerge": false,
    "vulnerabilityAlerts": {
      "enabled": true,
      "minimumReleaseAge": null,
      "schedule": [],
      "dependencyDashboardApproval": false,
      "stabilityDays": 0,
      "prCreation": "immediate"
    }
  }
